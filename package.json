{
  "name": "dsh-git-idea",
  "version": "0.3.0",
  "description": "A git plugin for DSH modelled on IDEA's VCS: a git icon beside the permission mode in the composer with the branch and pending-change count, a branch switcher on hover, an IDEA-style VCS panel on click (branch tree, commit graph, changes, commit detail, diff), a repository switcher when a session's workspace holds more than one repository, and a settings page. Registers no model tools and injects no prompt.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "engines": {
    "dsh": ">=0.1.5-rc.1"
  },
  "scripts": {
    "build": "node build.mjs && node build-package.mjs",
    "check": "node build.mjs --check && node build-package.mjs --check",
    "test": "node test/run-all.mjs",
    "prepack": "node build.mjs && node build-package.mjs"
  },
  "author": "mays-hi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mays-hi/dsh-git-idea.git"
  },
  "homepage": "https://github.com/mays-hi/dsh-git-idea#readme",
  "bugs": {
    "url": "https://github.com/mays-hi/dsh-git-idea/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "idea",
    "vcs",
    "ui",
    "commit-graph",
    "worktree"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
